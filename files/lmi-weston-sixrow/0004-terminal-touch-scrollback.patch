+#define TERMINAL_TOUCH_SLOP 12.0
+#define TERMINAL_TOUCH_DECISION_SLOP (2.0 * TERMINAL_TOUCH_SLOP)
+#define TERMINAL_TOUCH_VERTICAL_DOMINANCE 1.25
+#define TERMINAL_TOUCH_SELECTION_HOLD_MSEC 350
+
+static void
+terminal_reset_touch(struct terminal *terminal)
+{
+	terminal->touch_id = -1;
+	terminal->touch_mode = TERMINAL_TOUCH_NONE;
+	terminal->touch_down_time = 0;
+	terminal->touch_start_x = 0;
+	terminal->touch_start_y = 0;
+	terminal->touch_last_y = 0;
+	terminal->touch_scroll_remainder = 0;
+	terminal->dragging = SELECT_NONE;
+}
+
+static void
+terminal_begin_touch_selection(struct terminal *terminal,
+			       struct widget *widget)
+{
+	terminal->click_time = 0;
+	terminal->click_count = 0;
+	terminal->dragging = SELECT_CHAR;
+	terminal->selection_end_x =
+		terminal->selection_start_x = terminal->touch_start_x;
+	terminal->selection_end_y =
+		terminal->selection_start_y = terminal->touch_start_y;
+	recompute_selection(terminal);
+	widget_schedule_redraw(widget);
+}
