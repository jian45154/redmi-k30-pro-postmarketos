+		} else if (abs_x < TERMINAL_TOUCH_SLOP &&
+			   abs_y < TERMINAL_TOUCH_SLOP) {
+			return;
+		} else if (abs_y >=
+			   abs_x * TERMINAL_TOUCH_VERTICAL_DOMINANCE) {
+			terminal->touch_mode = TERMINAL_TOUCH_SCROLL;
+		} else if (abs_x >=
+			   abs_y * TERMINAL_TOUCH_VERTICAL_DOMINANCE) {
+			terminal->touch_mode = TERMINAL_TOUCH_SELECT;
+		} else if (abs_x < TERMINAL_TOUCH_DECISION_SLOP &&
+			   abs_y < TERMINAL_TOUCH_DECISION_SLOP) {
+			return;
+		} else if (abs_y >= abs_x) {
+			terminal->touch_mode = TERMINAL_TOUCH_SCROLL;
+		} else {
+			terminal->touch_mode = TERMINAL_TOUCH_SELECT;
+		}
